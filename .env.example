# DeepSeek API（必须配置）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型：deepseek-v4-pro / deepseek-v4-flash / deepseek-chat（旧，2026-07-24 弃用）/ deepseek-reasoner（旧，同上）
DEEPSEEK_MODEL=deepseek-v4-pro

# Web 服务
PORT=8088
# uvicorn 多进程数；默认 4 提升并发能力（与 asyncio.to_thread 配合）
# 注意：>1 时数字人模块的内存态任务进度无法跨进程共享，
# 如依赖 /api/digital-human/progress 轮询，请设为 1
UVICORN_WORKERS=4
# 推理模型需要更大预算（reasoning + 输出共享 max_tokens）；v4-pro 建议至少 8192
DEEPSEEK_MAX_TOKENS=8192

# 日志
LOG_LEVEL=INFO

# 用户代理（可选）
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# IndexTTS 本地运行时（默认即可；运行时文件放在 data/indextts_runtime/tts-2，不提交 Git）
# 首次使用前执行：python scripts/bootstrap_indextts_runtime.py --source "D:\BaiduNetdiskDownload\MetaHuman-2\MetaHuman4_V2\MetaHuman4_V2\tts-2"
INDEXTTS_PROJECT_DIR=data/indextts_runtime/tts-2
