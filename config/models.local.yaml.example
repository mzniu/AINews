# 复制为 models.local.yaml 后填写密钥（该文件已加入 .gitignore）
version: 1

language:
  active_id: deepseek_v4_pro
  profiles:
    - id: deepseek_v4_pro
      display_name: DeepSeek V4 Pro
      provider: deepseek
      base_url: https://api.deepseek.com
      model: deepseek-v4-pro
      api_key: sk-your-key-here
      max_tokens: 8192
      temperature: 0.7
      enabled: true

vision:
  active_id: qwen_vl_max
  profiles:
    - id: qwen_vl_max
      display_name: 通义千问 VL Max
      provider: qwen
      base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
      model: qwen-vl-max
      api_key: sk-your-key-here
      max_tokens: 2048
      temperature: 0.3
      enabled: false
